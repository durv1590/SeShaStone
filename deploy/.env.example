# SeSha Stone production settings. ./init.sh copies this to .env and fills in the secrets.
# .env is never committed. Keep a copy somewhere safe (e.g. a password manager).

# ── Domain and HTTPS ────────────────────────────────
# Without "www." — the stack serves www.$DOMAIN, admin.$DOMAIN and api.$DOMAIN.
DOMAIN=seshastone.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=

# ── Secrets (generated by ./init.sh) ────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=7d
MEILI_MASTER_KEY=

# ── Email through Gmail (docs/DEPLOYMENT.md → Email) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── First admin login (created by the first seed) ───
SEED_ADMIN_EMAIL=admin@seshastone.com
# Generated by ./init.sh. Change it from the admin panel after first login.
SEED_ADMIN_PASSWORD=

# ── Store details (written to Admin → Settings by the first seed; edit there afterwards) ──
SEED_STORE_LEGAL_NAME=SeSha Stone Pvt. Ltd.
SEED_STORE_WEBSITE=www.seshastone.com
SEED_STORE_EMAIL=
SEED_STORE_PHONE=
SEED_STORE_WHATSAPP=
SEED_STORE_ADDRESS=
SEED_GRIEVANCE_OFFICER_NAME=
SEED_UPI_ID=
SEED_UPI_PAYEE_NAME=
SEED_BANK_NAME=
SEED_BANK_ACCOUNT_NAME=
SEED_BANK_ACCOUNT_NUMBER=
SEED_BANK_IFSC=
SEED_BANK_BRANCH=
SEED_DEMO_PRODUCTS=false
