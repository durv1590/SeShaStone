# ── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Public storefront URL — used in password-reset links
WEB_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql://seshastone:seshastone@localhost:5432/seshastone?schema=public

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Storage (S3 / MinIO) ─────────────────────────────
S3_REGION=ap-south-1
S3_BUCKET=seshastone-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=seshastone
S3_SECRET_ACCESS_KEY=seshastone-secret
S3_PUBLIC_URL=http://localhost:9000/seshastone-media
S3_FORCE_PATH_STYLE=true

# ── Search (Meilisearch) ─────────────────────────────
# Uploaded images: "s3" (S3 / R2 / MinIO, above) or "local" (this server's disk, used by deploy/)
STORAGE_DRIVER=s3
# MEDIA_DIR=/data/media
# MEDIA_PUBLIC_URL=https://www.seshastone.com/media
# API_PUBLIC_URL=https://api.seshastone.com/api/v1

SEARCH_HOST=http://localhost:7700
SEARCH_API_KEY=seshastone-meili-master-key

# ── Payments ─────────────────────────────────────────
# Default gateway used at checkout: RAZORPAY | CASHFREE
PAYMENT_DEFAULT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ── Email (transactional notifications) ─────────────
# Leave SMTP_HOST empty to disable sending: notifications are then recorded as SKIPPED.
# Gmail (see docs/DEPLOYMENT.md → Email): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<the Gmail address>, SMTP_PASS=<16-character Google app password, not your Gmail password>,
# SMTP_FROM="SeSha Stone <the same Gmail address>". Never commit the real password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SeSha Stone <orders@seshastone.com>"

# ── Testing ──────────────────────────────────────────
# Disable rate limits for automated test runs. Ignored when NODE_ENV=production.
E2E_DISABLE_RATE_LIMIT=false

# ── Store details (written to Settings by `npm run db:seed`) ──
# Kept out of source control; after seeding, edit them in Admin → Settings.
SEED_STORE_LEGAL_NAME=
SEED_STORE_WEBSITE=
SEED_STORE_EMAIL=
SEED_STORE_PHONE=
SEED_UPI_ID=
SEED_UPI_PAYEE_NAME=
SEED_BANK_NAME=
SEED_BANK_ACCOUNT_NAME=
SEED_BANK_ACCOUNT_NUMBER=
SEED_BANK_IFSC=
SEED_BANK_BRANCH=
SEED_STORE_WHATSAPP=
SEED_STORE_ADDRESS=
# Named as Grievance Officer in the policy pages (required by the Consumer Protection (E-Commerce) Rules, 2020)
SEED_GRIEVANCE_OFFICER_NAME=
# Path to the original, verified UPI QR image (defaults to public/payment/upi-qr/current-upi-qr.png)
SEED_UPI_QR_PATH=
# Local development only: create clearly-labelled demo products
SEED_DEMO_PRODUCTS=false

# ── Seed admin ───────────────────────────────────────
SEED_ADMIN_EMAIL=admin@seshastone.com
SEED_ADMIN_PASSWORD=ChangeMe123!
