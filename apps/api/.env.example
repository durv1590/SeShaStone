# ── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql://seshastone:seshastone@localhost:5432/seshastone?schema=public

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Storage (S3 / MinIO) ─────────────────────────────
S3_REGION=ap-south-1
S3_BUCKET=seshastone-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=seshastone
S3_SECRET_ACCESS_KEY=seshastone-secret
S3_PUBLIC_URL=http://localhost:9000/seshastone-media
S3_FORCE_PATH_STYLE=true

# ── Search (Meilisearch) ─────────────────────────────
SEARCH_HOST=http://localhost:7700
SEARCH_API_KEY=seshastone-meili-master-key

# ── Payments ─────────────────────────────────────────
# Default gateway used at checkout: RAZORPAY | CASHFREE
PAYMENT_DEFAULT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ── Seed admin ───────────────────────────────────────
SEED_ADMIN_EMAIL=admin@seshastone.com
SEED_ADMIN_PASSWORD=ChangeMe123!
